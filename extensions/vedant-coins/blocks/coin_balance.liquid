<div id="vedant-header-coins-{{ block.id }}" class="vedant-header-coins" hidden>
  <button
    class="vedant-header-coins__trigger"
    type="button"
    aria-expanded="false"
    aria-controls="vedant-header-coins-popup-{{ block.id }}"
    aria-label="View your Vedant coin balance"
  >
    <svg class="vedant-header-coins__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="15" fill="#ffc526" />
      <circle cx="16" cy="16" r="11.5" fill="none" stroke="#f39a14" stroke-width="1.8" />
      <path d="M16 7.4 23 11v1.8H9V11l7-3.6Zm-5.1 6.9h2.2v7.4h-2.2v-7.4Zm4 0h2.2v7.4h-2.2v-7.4Zm4 0h2.2v7.4h-2.2v-7.4ZM8.8 23h14.4v2H8.8v-2Z" fill="#fff7cf" />
    </svg>
    <span class="vedant-header-coins__label">
      <span class="vedant-header-coins__amount" data-vedant-header-total>...</span>
      <span class="vedant-header-coins__unit">Coins</span>
    </span>
  </button>
  <div
    id="vedant-header-coins-popup-{{ block.id }}"
    class="vedant-header-coins__popup"
    role="dialog"
    aria-label="Your coin balance"
    hidden
  >
    <div class="vedant-header-coins__popup-header">
      <svg class="vedant-header-coins__popup-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="15" fill="#ffc526" />
        <circle cx="16" cy="16" r="11.5" fill="none" stroke="#f39a14" stroke-width="1.8" />
        <path d="M16 7.4 23 11v1.8H9V11l7-3.6Zm-5.1 6.9h2.2v7.4h-2.2v-7.4Zm4 0h2.2v7.4h-2.2v-7.4Zm4 0h2.2v7.4h-2.2v-7.4ZM8.8 23h14.4v2H8.8v-2Z" fill="#fff7cf" />
      </svg>
      <div class="vedant-header-coins__popup-balance">
        <strong>Your Coins</strong>
        <b data-vedant-header-popup-total>Balance unavailable</b>
      </div>
      <button class="vedant-header-coins__close" type="button" aria-label="Close coin balance">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m5 5 10 10M15 5 5 15" /></svg>
      </button>
    </div>
    <p class="vedant-header-coins__intro">Use your coins to get discounts on your purchase. Earn more coins with every order!</p>
    <div class="vedant-header-coins__divider"></div>
    <p class="vedant-header-coins__how-to">How to use coins?</p>
    <ol>
      <li>Add products to your cart.</li>
      <li>Choose "Use Coins" on the cart page.</li>
      <li>Your coins are automatically applied up to the available balance.</li>
    </ol>
  </div>
</div>

