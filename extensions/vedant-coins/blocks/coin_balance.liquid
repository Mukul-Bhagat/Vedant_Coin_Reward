  /* Updated compact header icon and fully visible balance card. */
  #vedant-header-coins-{{ block.id }} {
    --vedant-pink: #f83c86;
    --vedant-ink: #211d2b;
    overflow: visible;
  }

  #vedant-header-coins-{{ block.id }} .vedant-header-coins__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
