generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CustomerCoinBalance {
  id             String            @id @default(cuid())
  shop           String
  customerId     String
  availableCoins Int               @default(0)
  reservedCoins  Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  transactions   CoinTransaction[]

  @@unique([shop, customerId])
  @@index([shop])
  @@index([customerId])
}

model CoinTransaction {
  id                   String              @id @default(cuid())
  shop                 String
  customerId           String
  type                 String
  coins                Int
  balanceAfter         Int
  orderId              String?
  orderName            String?
  productId            String?
  productTitle         String?
  transactionKey       String              @unique
  relatedTransactionId String?
  status               String              @default("COMPLETED")
  description          String?
  expiresAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  lineItemId           String?
  rewardQuantity       Int?
  balance              CustomerCoinBalance @relation(fields: [shop, customerId], references: [shop, customerId])

  @@index([shop, customerId])
  @@index([shop, orderId])
  @@index([shop, orderId, lineItemId])
  @@index([shop, customerId, createdAt])
  @@index([customerId, orderId])
}

model CoinReservation {
  id              String   @id @default(cuid())
  shop            String
  customerId      String
  cartToken       String
  cartFingerprint String?
  coins           Int
  status          String   @default("ACTIVE")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, cartToken])
  @@index([shop, customerId])
  @@index([status, expiresAt])
}
